{
  "name": "woba-copilot",
  "version": "0.1.0",
  "description": "Asistente administrativo core para WOBA/BAE, Footprint y eWorks",
  "private": true,
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc && node scripts/verify-email-pdf-runtime.cjs && npm --prefix frontend-cerebro ci && npm --prefix frontend-cerebro run build",
    "start": "node dist/scripts/start.js",
    "dev": "tsx watch src/server.ts",
    "auditoria:publicar": "node scripts/publicar-auditoria-programada.mjs",
    "mail:auto:setup": "tsx scripts/mail-auto-db.ts setup",
    "mail:auto:status": "tsx scripts/mail-auto-db.ts status",
    "test:mail-auto": "node --import tsx --test core/gmail/automatico/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test core/**/*.test.ts && node --test scripts/claude-max/*.test.mjs frontend-cerebro/src/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@sparticuz/chromium": "147.0.1",
    "@types/heic-convert": "^2.1.1",
    "@types/pdfkit": "^0.17.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "googleapis": "^176.0.0",
    "heic-convert": "^2.1.0",
    "mpg123-decoder": "1.0.3",
    "msedge-tts": "2.0.7",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "puppeteer-core": "25.0.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.17"
  }
}
