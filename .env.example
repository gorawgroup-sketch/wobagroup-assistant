TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
PORT=3000
CASHFLOW_SHEET_ID=
HOLDED_API_KEY_WOBA=
HOLDED_API_KEY_EWORKS=
# API keys de Holded SEPARADAS, con permiso de escritura acotado al módulo de
# Contabilidad/Compras (generadas en Holded: Configuración > Desarrolladores >
# Credenciales > Añadir token de API). Las de arriba son de solo lectura.
# Se usan exclusivamente para el flujo de pagos recurrentes (docs/calendario_fiscal.json).
HOLDED_API_KEY_WRITE_WOBA=
HOLDED_API_KEY_WRITE_EWORKS=
# En producción (Railway), pega el JSON completo de la cuenta de servicio aquí
# en vez de depender del archivo local en /credentials. La misma cuenta de
# servicio autentica tanto Sheets (lectura y escritura) como Drive.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Chat de Telegram donde el job semanal envía las propuestas de movimientos
# no registrados (normalmente tu propio chat_id).
CASHFLOW_ALERTS_CHAT_ID=
# Lista de user_id de Telegram autorizados, con rol: "id:rol,id:rol,...".
# Roles: "admin" (todo, incluye aprobar escrituras) o "colaborador" (chatea,
# consulta, CAPTURA/corrección:, y puede descartar/cancelar propuestas, pero
# NO puede presionar los botones que disparan una escritura real: ✅ Agregar
# en cashflow, ✅ Confirmar pago recurrente, 📤 Enviar así, ✅ Sí archivar aquí).
# Ej: "8731933107:admin,111222333:colaborador". Un id sin ":rol" válido se
# trata como "colaborador" (nunca admin por defecto). Sin esta variable (o
# vacía), NADIE puede usar el bot — falla cerrado a propósito. El user_id de
# alguien se obtiene revisando los logs tras su primer mensaje bloqueado
# ("[auth] Bloqueado usuario no autorizado — id: ...").
TELEGRAM_ALLOWED_USER_IDS=
# Secret para poder forzar POST /admin/run-holded-check manualmente sin
# esperar al cron. Genera uno propio, no reutilices el de ejemplo.
ADMIN_SECRET=
# Email de un usuario real de Google Workspace con acceso de Editor a las
# carpetas de Drive del grupo. La cuenta de servicio "impersona" a este
# usuario (vía delegación de dominio, configurada en el Admin Console) para
# poder subir archivos — las cuentas de servicio no tienen cuota propia.
GOOGLE_IMPERSONATE_EMAIL=
# Buzón dedicado del asistente (ej. asistente@wobagroup.com), distinto del
# de arriba — Gmail lee este buzón, Drive sigue subiendo como la persona de
# GOOGLE_IMPERSONATE_EMAIL. Misma delegación de dominio, distinto usuario.
GMAIL_IMPERSONATE_EMAIL=
