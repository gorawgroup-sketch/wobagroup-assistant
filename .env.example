TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
# Guardia híbrida de IA. "observe" no cambia el comportamiento mientras se
# recopila atribución por proceso. Tras validar una alternativa varios ciclos,
# usar "allowlist" o "disabled"; el kill switch siempre prevalece.
WOBI_AI_API_MODE=observe
WOBI_AI_API_KILL_SWITCH=false
WOBI_AI_API_ALLOWED_PROCESSES=
WOBI_AI_API_DAILY_LIMIT_USD=0
WOBI_AI_API_MONTHLY_LIMIT_USD=0
# Proveedor de la autorrevisión nocturna de código:
# - api: ruta histórica de Railway (valor seguro por defecto)
# - claude_max_shadow: API + ejecución paralela de Claude Max para comparar
# - claude_max: omite la llamada API; usar solo tras >=5 ciclos sombra correctos
# El workflow de GitHub usa CLAUDE_CODE_OAUTH_TOKEN como secret del repositorio;
# ese token nunca debe añadirse a Railway, este archivo ni los logs.
WOBI_AUTOREVISION_PROVIDER=api
PORT=3000
CASHFLOW_SHEET_ID=
HOLDED_API_KEY_WOBA=
HOLDED_API_KEY_EWORKS=
# API keys de Holded SEPARADAS, con permiso de escritura acotado al módulo de
# Contabilidad/Compras (generadas en Holded: Configuración > Desarrolladores >
# Credenciales > Añadir token de API). Las de arriba son de solo lectura.
# Se usan para pagos recurrentes (docs/calendario_fiscal.json) y para
# conciliación de facturas/gastos puntuales (core/gastos/).
HOLDED_API_KEY_WRITE_WOBA=
HOLDED_API_KEY_WRITE_EWORKS=
# Footprint: a diferencia de WOBA/EWORKS, esta key vino con permiso de
# lectura Y escritura en una sola credencial — se usa el mismo valor para
# ambas variables. Footprint NO tiene acceso a cashflow en Sheets todavía
# (solo Holded directo: movimientos bancarios, gastos, adjuntar comprobantes).
HOLDED_API_KEY_FOOTPRINT=
HOLDED_API_KEY_WRITE_FOOTPRINT=
# En producción (Railway), pega el JSON completo de la cuenta de servicio aquí
# en vez de depender del archivo local en /credentials. La misma cuenta de
# servicio autentica tanto Sheets (lectura y escritura) como Drive.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Chat de Telegram donde el job semanal envía las propuestas de movimientos
# no registrados (normalmente tu propio chat_id).
CASHFLOW_ALERTS_CHAT_ID=
# La lista de usuarios autorizados de Telegram (con rol admin/colaborador) ya
# NO vive en una variable de entorno — se guarda en la pestaña oculta
# _usuarios_autorizados del Sheet de CASHFLOW_SHEET_ID (core/telegram/
# authorizedUsersSheet.ts), para poder autorizar gente nueva con un botón
# desde Telegram (core/telegram/adminNotify.ts) sin tocar Railway. Si el
# Sheet no tiene ningún admin todavía, hay que sembrar el primero a mano
# (ver el historial de commits de authorizedUsersSheet.ts para el patrón).
# Secret para poder forzar POST /admin/run-holded-check manualmente sin
# esperar al cron. Genera uno propio, no reutilices el de ejemplo.
ADMIN_SECRET=
# Email de un usuario real de Google Workspace con acceso de Editor a las
# carpetas de Drive del grupo. La cuenta de servicio "impersona" a este
# usuario (vía delegación de dominio, configurada en el Admin Console) para
# poder subir archivos — las cuentas de servicio no tienen cuota propia.
GOOGLE_IMPERSONATE_EMAIL=
# Buzón dedicado del asistente (ej. asistente@wobagroup.com), distinto del
# de arriba — Gmail lee este buzón, Drive sigue subiendo como la persona de
# GOOGLE_IMPERSONATE_EMAIL. Misma delegación de dominio, distinto usuario.
GMAIL_IMPERSONATE_EMAIL=
# Token fine-grained de GitHub, acotado solo al repo gorawgroup-sketch/wobagroup-assistant
# (Settings > Developer settings > Fine-grained tokens). Usado por core/github/client.ts para la
# autorrevisión nocturna de código (leer/crear ramas/PRs — permisos "Contents: Read and write" y
# "Pull requests: Read and write") y para escalar reportes del chat a development como GitHub Issues
# (core/tools/escalarDesarrollo.ts — necesita además "Issues: Read and write").
GITHUB_TOKEN=

# Bloque 1: límites POR SOLICITUD, no por turno completo. Vacío usa el valor por defecto.
# Haiku 60 s, Sonnet 120 s, otros 180 s; rango permitido 5–300 s.
WOBI_AI_HAIKU_TIMEOUT_MS=
WOBI_AI_SONNET_TIMEOUT_MS=
WOBI_AI_OTHER_TIMEOUT_MS=
# Reintentos internos SDK: 0 por defecto, máximo 2, dentro del mismo límite total.
WOBI_AI_MAX_RETRIES=
# Solo lecturas explícitamente auditadas: 45 s por defecto (5–180 s).
# NO cancela escrituras, conciliaciones ni herramientas que llaman a otros modelos.
WOBI_READ_TOOL_TIMEOUT_MS=

# Bloque 2: lecturas independientes en paralelo (solo herramientas auditadas).
# false vuelve a lotes secuenciales; no desactiva los bloqueos de seguridad.
WOBI_PARALLEL_READS_ENABLED=true
# Por proceso: 4 lecturas simultáneas; por identidad compartida web/Telegram: 2.
WOBI_READ_CONCURRENCY_GLOBAL=4
WOBI_READ_CONCURRENCY_PER_CHAT=2
WOBI_READ_CONCURRENCY_CASHFLOW=1
# Admisión en cola: 30 s; máximo 32 pendientes. Vencer aquí NO inicia una acción.
WOBI_TOOL_QUEUE_TIMEOUT_MS=30000
WOBI_TOOL_QUEUE_MAX_PENDING=32

# Bloque 3: cachés de ráfaga con single-flight. Los valores se muestran con
# su antigüedad al modelo y se invalidan tras escrituras confirmadas de WOBI.
# Cashflow y cuentas Holded: 10 s (0–60 s). Eventos: 30 s (0–120 s).
# 0 desactiva la reutilización posterior pero mantiene el single-flight simultáneo.
WOBI_CASHFLOW_CACHE_TTL_MS=10000
WOBI_HOLDED_CACHE_TTL_MS=10000
WOBI_HOLDED_EVENTS_CACHE_TTL_MS=30000

# Un cron espera hasta 30 s si coincide con herramientas de un chat activo.
# Pasado el límite continúa para no quedar bloqueado indefinidamente.
WOBI_CRON_INTERACTIVE_GRACE_MS=30000

# Bloque 4A: ledger durable de entrada Telegram en el Sheet existente.
# false restaura temporalmente el ACK inmediato y deduplicación solo en memoria.
WOBI_TELEGRAM_DURABLE_ENABLED=true
# Una reserva ajena espera 5 s antes de recuperarse; una ejecución iniciada
# espera 120 s antes de declararse incierta. Retención terminal: 30 días.
WOBI_TELEGRAM_RESERVATION_GRACE_MS=5000
WOBI_TELEGRAM_UNCERTAIN_AFTER_MS=120000
WOBI_TELEGRAM_LEDGER_RETENTION_DAYS=30

# Ledger exactly-once de Gmail. Solo conserva hashes, ids técnicos, estados y tiempos; nunca cuerpo/asunto/destinatario.
WOBI_EMAIL_DURABLE_ENABLED=true
WOBI_EMAIL_LEDGER_RETENTION_DAYS=180

# Ledger de subidas a Drive. El archivo recibe un marcador privado y los
# estados/ids técnicos se conservan en el Sheet; nunca guarda contenido ni nombre.
WOBI_DRIVE_DURABLE_ENABLED=true
WOBI_DRIVE_LEDGER_RETENTION_DAYS=180
